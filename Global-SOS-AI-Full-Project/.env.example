# Public directory works in read-only mode without any secrets or DATABASE_URL.
NODE_ENV=production
PORT=3000
# Use the PostgreSQL connection string supplied by Neon or Render.
# Retain the provider's TLS parameters. Certificate verification is never disabled.
DATABASE_URL=
APP_BASE_URL=https://your-service.onrender.com
CORS_ORIGINS=https://your-service.onrender.com
# Optional admin features require PostgreSQL and TWO different random tokens, >=32 characters.
ADMIN_REVIEW_TOKEN=
ADMIN_PUBLISH_TOKEN=
# none | openai-compatible. Model service runs separately from this web service.
AI_PROVIDER=none
AI_BASE_URL=http://127.0.0.1:8080/v1
AI_MODEL=smollm2-360m-instruct
AI_API_KEY=
AI_TIMEOUT_MS=10000
# Seconds between checks. Minimum enforced: 3600. Set a real operator contact before enabling.
DIRECTORY_UPDATE_INTERVAL=86400
MONITOR_CONTACT=
# SESSION_SECRET/JWT_SECRET are not used: this release has no account login or JWTs.
# API_BASE_URL is an Android build-time --dart-define, not a PostgreSQL connection string.

# Optional trusted-contact provider alerts. No provider is contacted until enabled by the user.
# Private operator deployment: approve each consenting recipient; never put public helplines here.
ALERT_CLIENT_TOKEN=
ALERT_ALLOWED_RECIPIENTS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
# Include whatsapp: prefix on the sender; use an approved template with message variable 1.
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TEMPLATE_SID=
RESEND_API_KEY=
ALERT_EMAIL_FROM=
